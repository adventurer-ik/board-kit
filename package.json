{
  "name": "board-kit",
  "version": "0.1.0",
  "description": "작은 소통 게시판 — 어떤 관리 화면에도 붙여 쓰는 독립 모듈 (SQLite 파일 하나 · NestJS 어댑터 · React 화면)",
  "license": "MIT",
  "author": "adventurer-ik",
  "repository": { "type": "git", "url": "https://github.com/adventurer-ik/board-kit.git" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./web": "./src/web/index.ts",
    "./shared": "./src/shared/index.ts"
  },
  "files": ["dist", "src", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11",
    "@tanstack/react-query": ">=5",
    "better-sqlite3": ">=12",
    "lucide-react": ">=0.400",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": { "optional": true },
    "@tanstack/react-query": { "optional": true },
    "lucide-react": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.6",
    "@tanstack/react-query": "^5.103.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "better-sqlite3": "^12.4.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
